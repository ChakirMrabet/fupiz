generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = env("DATABASE_PROVIDER")
}

model User {
  id                       Int       @id @default(autoincrement())
  email                    String    @unique
  name                     String?
  password                 String
  role                     String    @default("USER")
  plan                     String    @default("FREE")
  stripeCustomerId         String?   @unique
  stripeSubscriptionId     String?   @unique
  stripePriceId            String?
  stripeSubscriptionStatus String?
  stripeCurrentPeriodEnd   DateTime?
  cancelAtPeriodEnd        Boolean   @default(false)
  isActive                 Boolean   @default(false)
  activationToken          String?   @unique
  activationTokenExpiresAt DateTime?
  activatedAt              DateTime?
  links                    Link[]
  webhooks                 Webhook[]
  adminAuditLogs           AdminAuditLog[] @relation("AdminActorAuditLogs")
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

model Link {
  id                 Int         @id @default(autoincrement())
  originalUrl        String
  shortCode          String      @unique
  password           String?
  expiresAt          DateTime?
  maxClicks          Int?
  singleUse          Boolean     @default(false)
  landingTitle       String?
  landingDescription String?
  landingButtonLabel String?
  isActive           Boolean     @default(true)
  clicks             Int         @default(0)
  userId             Int?
  user               User?       @relation(fields: [userId], references: [id])
  clickEvents        LinkClick[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model LinkClick {
  id        Int      @id @default(autoincrement())
  linkId    Int
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  browser   String?
  os        String?
  referer   String?
  country   String?
  createdAt DateTime @default(now())

  @@index([linkId])
  @@index([createdAt])
}

model Webhook {
  id                 Int      @id @default(autoincrement())
  userId             Int
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url                String
  secret             String
  events             String
  isActive           Boolean  @default(true)
  lastDeliveryAt     DateTime?
  lastDeliveryStatus String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
}

model AdminAuditLog {
  id           Int      @id @default(autoincrement())
  actorUserId  Int
  actorUser    User     @relation("AdminActorAuditLogs", fields: [actorUserId], references: [id], onDelete: Cascade)
  action       String
  targetType   String
  targetId     Int
  targetLabel  String?
  changes      String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
}
